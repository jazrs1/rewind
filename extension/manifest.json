{
  "manifest_version": 3,
  "name": "Rewind importer",
  "version": "0.1.0",
  "key": "",
  "description": "Exports a Canvas course you can already see into a .course.json file for Rewind.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://ufl.instructure.com/*",
    "https://ufl.zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://rewindit.org/*",
      "https://www.rewindit.org/*"
    ]
  },
  "action": {
    "default_title": "Rewind: export Canvas course",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ufl.instructure.com/*"
      ],
      "js": [
        "canvas/canvas-api.js",
        "canvas/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ufl.zoom.us/rec/*"
      ],
      "js": [
        "zoom/transcript.js",
        "zoom/player.js",
        "zoom/embed.js",
        "zoom/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
